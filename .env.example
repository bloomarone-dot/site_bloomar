# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=8000

# ─── Base de données PostgreSQL (Docker) ───────────────────────────────────────
POSTGRES_USER=bloomar
POSTGRES_PASSWORD=bloomar
POSTGRES_DB=bloomar
DATABASE_URL=postgresql://bloomar:bloomar@db:5432/bloomar

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# ─── CMS Auth (Sprint 0) ───────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@bloomarone.com
BOOTSTRAP_ADMIN_PASSWORD=BloomarCMS2026!
BOOTSTRAP_ADMIN_NAME=Super Admin
ENVIRONMENT=development

# ─── Media ─────────────────────────────────────────────────────────────────────
MEDIA_ROOT=storage/media
MEDIA_MAX_UPLOAD_MB=50

# ─── Cache Redis (Sprint 1) ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL=300
PREVIEW_TOKEN_EXPIRE_HOURS=24

# ─── EMAIL ─────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="BL∞MAR ONE <contact@bloomarone.com>"
MAIL_TO=contact@bloomarone.com
